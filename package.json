{
  "name": "textor",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Textor — a privacy-first, end-to-end-encrypted messenger that runs entirely as a static app.",
  "keywords": [
    "messenger",
    "end-to-end-encryption",
    "nostr",
    "nip-17",
    "nip-44",
    "nip-59",
    "mls",
    "webrtc",
    "pwa",
    "privacy",
    "serverless"
  ],
  "homepage": "https://noormohammadiazad.github.io/Textor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noormohammadiazad/Textor.git"
  },
  "bugs": {
    "url": "https://github.com/Noormohammadiazad/Textor/issues"
  },
  "author": "Noormohammadiazad",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"docs/*.md\"",
    "relays:probe": "node scripts/probe-relays.mjs",
    "turn:probe": "node scripts/probe-turn.mjs",
    "voice:probe": "node scripts/probe-voice.mjs",
    "retention:probe": "node scripts/probe-retention.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:tokens && npm run test:coverage",
    "icons": "node scripts/generate-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "rotate:workflow": "node scripts/rotateWorkflow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "nostr-tools": "2.25.0",
    "qr": "^0.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-mls": "1.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
